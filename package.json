{
  "name": "mdview",
  "version": "2.0.0",
  "description": "MDView by KEC — a split-view Markdown editor and viewer for Windows",
  "main": "./out/main/index.js",
  "author": {
    "name": "KEC",
    "email": "kwokhow.lou@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/kwokhow/MDView#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwokhow/MDView.git"
  },
  "bugs": {
    "url": "https://github.com/kwokhow/MDView/issues"
  },
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "windows",
    "mdview",
    "kec",
    "split-view",
    "preview"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.4",
    "@types/markdown-it": "^14.2.0",
    "dompurify": "^3.4.16",
    "electron": "^33.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^29.1.1",
    "lucide": "^1.48.0",
    "markdown-it": "^15.0.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.kec.mdview",
    "productName": "MDView",
    "copyright": "Copyright © 2026 KEC",
    "publish": [
      {
        "provider": "github",
        "owner": "kwokhow",
        "repo": "MDView"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MDView"
    },
    "portable": {
      "artifactName": "MDView-${version}-portable.exe"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown file",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "description": "Markdown file",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ]
  }
}
